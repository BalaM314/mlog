clear_bombs_loop:
getblock block block x 1
setblock block block x 1
jump clear_bombs_next_1 always 0 0
clear_bombs_next_1:
getblock block block x 2
setblock block block x 2
jump clear_bombs_next_2 always 0 0
clear_bombs_next_2:
getblock block block x 3
setblock block block x 3
jump clear_bombs_next_3 always 0 0
clear_bombs_next_3:
