clear_bombs_next_467:
op add x x 1
jump clear_bombs_loop lessThan x @mapw
fetch unitCount units @sharded
set i 0
teleport_units_sharded_loop:
fetch unit unit @sharded i
sensor unit.y unit @y
jump teleport_units_sharded_next greaterThan unit.y 5.5
op sub y 468 unit.y
setprop @y unit y
teleport_units_sharded_next:
op add i i 1
jump teleport_units_sharded_loop lessThan i units
fetch unitCount units @green
set i 0
teleport_units_green_loop:
fetch unit unit @green i
sensor unit.y unit @y
jump teleport_units_green_next lessThan unit.y 462.5
op sub y 468 unit.y
setprop @y unit y
teleport_units_green_next:
op add i i 1
jump teleport_units_green_loop lessThan i units
set x 0
explosion_loop:
explosion @sharded x 464 10 5000 true true false
explosion @green x 5 10 5000 true true false
op add x x 1
jump explosion_loop lessThan x @mapw
op add nextTeleport nextTeleport 30
jump wait_for_time always 0 0