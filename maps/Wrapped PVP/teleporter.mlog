print "Teleporter logic for Wrapped PVP"
print "by [#3141FF]BalM[#31FF41]314"
op sub nextTeleport 120 10
wait_for_time:
setrate 2
wait_for_time_loop:
jump wait_for_time_loop lessThan @second nextTeleport
setrate 200
set x 0
effect_loop_2_1:
effect placeBlock x 3 2 0 0
effect placeBlock x 465 2 0 0
op add x x 2
jump effect_loop_2_1 lessThan x @mapw
wait 2
set x 0
