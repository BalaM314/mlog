# Recursive factorial
print "Recursive factorial"
printflush null
set stack cell1

loop:
	set arg1 6 //begin function call
	set returnAddress @counter + 3
	push returnAddress stack
	jump factorial //end function call
	printf "[green]Factorial is {out}"
	printflush message1
	wait 1
	jump loop

factorial:
	printf "Calculating factorial({arg1}), stackptr({_stackptr})"
	printflush message1
	wait 0.5
	jump base_case arg1 <= 1

	general_case:
		push arg1 stack
		set arg1 arg1 - 1 //function call
		set returnAddress @counter + 3
		push returnAddress stack
		jump factorial //end function call
		//retrieve the value of arg1 from the stack
		pop arg1 stack

		set out out * arg1 //calculate
		printf "Returning {out} from general case"
		printflush message1
		wait 0.5
		pop @counter stack

	base_case:
		set out arg1
		printf "Returning {out} from base case"
		printflush message1
		wait 0.5
		pop @counter stack

err:
	print "Stack overflow"
	printflush message1
	wait 0.5
	set _stackptr 0
