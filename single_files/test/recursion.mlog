print "Recursive factorial"
printflush null
set stack cell1
loop:
set arg1 6
op add returnAddress @counter 3
write returnAddress stack _stackptr
op add _stackptr _stackptr 1
jump factorial always 0 0
print "[green]Factorial is "
print out
printflush message1
wait 1
jump loop always 0 0
factorial:
print "Calculating factorial("
print arg1
print "), stackptr("
print _stackptr
print ")"
printflush message1
wait 0.5
jump base_case lessThanEq arg1 1
general_case:
write arg1 stack _stackptr
op add _stackptr _stackptr 1
op sub arg1 arg1 1
op add returnAddress @counter 3
write returnAddress stack _stackptr
op add _stackptr _stackptr 1
jump factorial always 0 0
op sub _stackptr _stackptr 1
read arg1 stack _stackptr
op mul out out arg1
print "Returning "
print out
print " from general case"
printflush message1
wait 0.5
op sub _stackptr _stackptr 1
read @counter stack _stackptr
base_case:
set out arg1
print "Returning "
print out
print " from base case"
printflush message1
wait 0.5
op sub _stackptr _stackptr 1
read @counter stack _stackptr
err:
print "Stack overflow"
printflush message1
wait 0.5
set _stackptr 0
end
print "Made with mlogx"
print "github.com/BalaM314/mlogx/"